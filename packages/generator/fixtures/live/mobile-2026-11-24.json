   "shell": "default",
   "title": "Customer Profile",
   "children": [
    {
     "id": "heading1",
     "text": "Customer Profile",
     "type": "Heading",
     "level": "1"
    },
    {
     "id": "formProfile",
     "type": "Form",
     "title": "Edit Profile",
     "children": [
      {
       "id": "secIdentity",
       "type": "Section",
       "title": "Identity Details",
       "children": [
        {
         "id": "inputName",
         "type": "Input",
         "field": "customer.name",
         "label": "Customer Name",
         "required": true,
         "inputType": "text",
         "placeholder": "Ahmed Al Hammadi"
        },
        {
         "id": "inputUAEPass",
         "type": "Input",
         "field": "customer.uaePassId",
         "label": "UAE Pass ID",
         "required": true,
         "inputType": "text",
         "placeholder": "UAE1234567890"
        }
       ]
      },
      {
       "id": "secContact",
       "type": "Section",
       "title": "Contact Information",
       "children": [
        {
         "id": "inputMobile",
         "type": "Input",
         "field": "customer.mobileNumber",
         "label": "Mobile Number",
         "required": true,
         "inputType": "phone",
         "placeholder": "+971 50 123 4567"
        },
        {
         "id": "inputEmail",
         "type": "Input",
         "field": "customer.email",
         "label": "Email",
         "required": true,
         "inputType": "email",
         "placeholder": "ahmed.hammadi@example.com"
        }
       ]
      },
      {
       "id": "secEmployment",
       "type": "Section",
       "title": "Employment Details",
       "children": [
        {
         "id": "inputEmployer",
         "type": "Input",
         "field": "employment.employer",
         "label": "Employer",
         "required": true,
         "inputType": "text",
         "placeholder": "Emirates Aviation"
        },
        {
         "id": "selectEmploymentStatus",
         "type": "Select",
         "field": "employment.status",
         "label": "Employment Status",
         "options": [
          "Full-time",
          "Part-time",
          "Contract",
          "Self-employed",
          "Unemployed"
         ],
         "required": true
        },
        {
         "id": "inputSalary",
         "type": "Input",
         "field": "income.currentSalary",
         "label": "Current Salary (AED/month)",
         "required": true,
         "inputType": "currency",
         "placeholder": "AED 18,500"
        }
       ]
      },
      {
       "id": "secIncomeOther",
       "type": "Section",
       "title": "Additional Income",
       "children": [
        {
         "id": "inputAdditionalIncome",
         "type": "Input",
         "field": "income.additionalIncome",
         "label": "Additional Income (AED/month)",
         "required": false,
         "inputType": "currency",
         "placeholder": "AED 2,000"
        }
       ]
      }
     ]
    },
    {
     "id": "actionsStack",
     "gap": "md",
     "type": "Stack",
     "align": "center",
     "children": [
      {
       "id": "btnCancel",
       "type": "Button",
       "label": "Cancel",
       "actions": [
        {
         "type": "navigate",
         "screen": "dashboard",
         "passRecord": false
        }
       ],
       "variant": "link"
      },
      {
       "id": "btnSave",
       "type": "Button",
       "label": "Save Changes",
       "actions": [
        {
         "form": "formProfile",
         "type": "submit",
         "validate": true
        },
        {
         "type": "toast",
         "message": "Profile changes saved successfully."
        },
        {
         "type": "navigate",
         "screen": "dashboard",
         "passRecord": false
        }
       ],
       "variant": "primary"
      }
     ],
     "direction": "horizontal"
    }
   ],
   "subtitle": "View and update your personal and employment details securely."
  }
 ],
