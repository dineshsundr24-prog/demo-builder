{
 "schemaVersion": 2,
 "id": "ididi-bank",
 "name": "IDIDI BANK",
 "channel": "mobile",
 "theme": {
  "primary": "#0052CC",
  "secondary": "#0086FF",
  "accent": "#003D99",
  "radius": "lg",
  "font": "inter"
 },
 "shell": {
  "kind": "tabs",
  "brand": "IDIDI BANK",
  "showBack": true,
  "items": [
   {
    "id": "menu-1",
    "label": "Dashboard",
    "icon": "layout-dashboard",
    "screen": "dashboard"
   },
   {
    "id": "menu-2",
    "label": "Income",
    "icon": "credit-card",
    "screen": "income"
   },
   {
    "id": "menu-3",
    "label": "Settings",
    "icon": "settings",
    "screen": "welcome"
   }
  ]
 },
 "collections": [
  {
   "id": "income-details",
   "label": "Income Details",
   "key": "id",
   "fields": [
    {
     "id": "id",
     "label": "ID"
    },
    {
     "id": "employer",
     "label": "Employer"
    },
    {
     "id": "salary",
     "label": "Monthly Salary (AED)"
    },
    {
     "id": "employmentStatus",
     "label": "Employment Status"
    }
   ],
   "rows": [
    {
     "id": "1",
     "employer": "IDIDI Corp",
     "salary": "15000",
     "employmentStatus": "Full-Time"
    },
    {
     "id": "2",
     "employer": "Freelance Consulting",
     "salary": "8000",
     "employmentStatus": "Part-Time"
    }
   ]
  }
 ],
 "screens": [
  {
   "id": "welcome",
   "title": "Welcome",
   "subtitle": "Welcome to IDIDI BANK, your trusted partner in managing your finances.",
   "shell": "hidden",
   "children": [
    {
     "type": "Hero",
     "id": "hero-welcome",
     "title": "Welcome to IDIDI BANK",
     "subtitle": "Your trusted partner in banking solutions.",
     "showLogo": true,
     "illustration": "welcome"
    },
    {
     "type": "ActionBar",
     "id": "actionbar-welcome",
     "primary": {
      "label": "Sign In",
      "actions": [
       {
        "type": "navigate",
        "screen": "standard-sign-in",
        "passRecord": false
       }
      ]
     },
     "secondary": {
      "label": "Sign Up",
      "actions": [
       {
        "type": "navigate",
        "screen": "standard-sign-up",
        "passRecord": false
       }
      ]
     }
    }
   ]
  },
  {
   "id": "standard-sign-in",
   "title": "Standard Sign In",
   "subtitle": "Access your IDIDI BANK account securely",
   "shell": "hidden",
   "children": [
    {
     "type": "Hero",
     "id": "hero1",
     "title": "Welcome back to IDIDI BANK",
     "subtitle": "Sign in to manage your accounts easily",
     "showLogo": true,
     "illustration": "none"
    },
    {
     "type": "Form",
     "id": "signin-form",
     "title": "Sign in",
     "children": [
      {
       "type": "Radio",
       "id": "signin-method",
       "field": "customer.signinMethod",
       "label": "Sign in with",
       "required": true,
       "options": [
        "Email",
        "Mobile"
       ]
      },
      {
       "type": "Input",
       "id": "email-mobile",
       "field": "customer.emailOrMobile",
       "label": "Email or Mobile",
       "required": true,
       "inputType": "text",
       "placeholder": "Enter your email or mobile number"
      },
      {
       "type": "Input",
       "id": "password-input",
       "field": "customer.password",
       "label": "Password",
       "required": true,
       "inputType": "password",
       "placeholder": "Enter your password"
      },
      {
       "type": "Checkbox",
       "id": "remember-me",
       "field": "customer.rememberMe",
       "label": "Remember Me",
       "required": false
      },
      {
       "type": "Button",
       "id": "signin-button",
       "label": "Sign In",
       "variant": "primary",
       "actions": [
        {
         "type": "submit",
         "form": "signin-form",
         "validate": true
        },
        {
         "type": "navigate",
         "screen": "dashboard",
         "passRecord": false
        }
       ]
      }
     ]
    },
    {
     "type": "Text",
     "id": "forgot-password",
     "text": "Forgot Password?",
     "tone": "muted"
    },
    {
     "type": "Button",
     "id": "signup-link",
     "label": "Create an account",
     "variant": "link",
     "actions": [
      {
       "type": "navigate",
       "screen": "standard-sign-up",
       "passRecord": false
      }
     ]
    }
   ]
  },
  {
   "id": "standard-sign-up",
   "title": "Standard Sign Up",
   "subtitle": "Create your account with IDIDI BANK to start managing your finances securely.",
   "shell": "hidden",
   "children": [
    {
     "type": "Form",
     "id": "signUpForm",
     "title": "Create your account",
     "children": [
      {
       "type": "Input",
       "id": "inputFullName",
       "field": "customer.fullName",
       "label": "Full Name",
       "required": true,
       "inputType": "text",
       "placeholder": "Enter your full name"
      },
      {
       "type": "Input",
       "id": "inputEmail",
       "field": "customer.email",
       "label": "Email",
       "required": true,
       "inputType": "email",
       "placeholder": "Enter your email address"
      },
      {
       "type": "Input",
       "id": "inputMobile",
       "field": "customer.mobile",
       "label": "Mobile",
       "required": true,
       "inputType": "phone",
       "placeholder": "Enter your mobile number"
      },
      {
       "type": "Input",
       "id": "inputPassword",
       "field": "customer.password",
       "label": "Password",
       "required": true,
       "inputType": "password",
       "placeholder": "Create a password"
      },
      {
       "type": "Input",
       "id": "inputPasswordConfirm",
       "field": "customer.passwordConfirm",
       "label": "Confirm Password",
       "required": true,
       "inputType": "password",
       "placeholder": "Confirm your password"
      },
      {
       "type": "Checkbox",
       "id": "checkboxTerms",
       "field": "customer.termsConsent",
       "label": "I agree to the terms and conditions",
       "required": true
      }
     ]
    },
    {
     "type": "ActionBar",
     "id": "signUpActionBar",
     "primary": {
      "label": "Sign Up",
      "actions": [
       {
        "type": "submit",
        "form": "signUpForm",
        "validate": true
       },
       {
        "type": "navigate",
        "screen": "dashboard",
        "passRecord": false
       }
      ]
     },
     "secondary": {
      "label": "Sign In",
      "actions": [
       {
        "type": "navigate",
        "screen": "standard-sign-in",
        "passRecord": false
       }
      ]
     }
    }
   ]
  },
  {
   "id": "dashboard",
   "title": "Dashboard",
   "subtitle": "Account summary and navigation",
   "shell": "default",
   "children": [
    {
     "type": "ProfileHeader",
     "id": "profileHeader1",
     "name": "John Doe",
     "subtitle": "Customer since 2020",
     "badge": "Premium"
    },
    {
     "type": "BalanceCard",
     "id": "balanceCard1",
     "label": "Account Balance",
     "amount": "AED 45,000",
     "caption": "Primary Account",
     "accountName": "John Doe",
     "accountNumber": "1234567890"
    },
    {
     "type": "Card",
     "id": "refCard",
     "title": "Latest Reference Number",
     "tone": "muted",
     "children": [
      {
       "type": "Text",
       "id": "refText",
       "text": "REF123456789",
       "tone": "default"
      }
     ]
    },
    {
     "type": "QuickActions",
     "id": "quickActions1",
     "title": "Quick Actions",
     "items": [
      {
       "label": "Update Income",
       "icon": "briefcase",
       "actions": [
        {
         "type": "navigate",
         "screen": "income",
         "passRecord": false
        }
       ]
      },
      {
       "label": "Transfer",
       "icon": "send",
       "actions": [
        {
         "type": "toast",
         "message": "Transfer feature coming soon"
        }
       ]
      },
      {
       "label": "Statements",
       "icon": "file-text",
       "actions": [
        {
         "type": "toast",
         "message": "Statements feature coming soon"
        }
       ]
      }
     ]
    },
    {
     "type": "ActionBar",
     "id": "actionBar1",
     "primary": {
      "label": "Go to Income",
      "actions": [
       {
        "type": "navigate",
        "screen": "income",
        "passRecord": false
       }
      ]
     },
     "secondary": {
      "label": "Settings",
      "actions": [
       {
        "type": "navigate",
        "screen": "standard-sign-in",
        "passRecord": false
       }
      ]
     }
    }
   ]
  },
  {
   "id": "income",
   "title": "Income",
   "subtitle": "Update your income details below",
   "shell": "default",
   "children": [
    {
     "type": "Section",
     "id": "currentDetailsSection",
     "title": "Current Income Details",
     "description": "Review your current employer, salary, and employment status.",
     "children": [
      {
       "type": "RecordFields",
       "id": "currentIncomeRecordFields",
       "items": [
        {
         "label": "Employer",
         "value": "IDIDI Corp"
        },
        {
         "label": "Current Salary",
         "value": "15,000 AED"
        },
        {
         "label": "Employment Status",
         "value": "Full-Time"
        }
       ]
      }
     ]
    },
    {
     "type": "Form",
     "id": "incomeDetailsForm",
     "title": "Update Income Information",
     "children": [
      {
       "type": "Input",
       "id": "employerInput",
       "field": "income.employer",
       "label": "Employer Name",
       "required": true,
       "inputType": "text",
       "placeholder": "Enter your employer name"
      },
      {
       "type": "Input",
       "id": "salaryInput",
       "field": "income.monthlySalary",
       "label": "Monthly Salary (AED)",
       "required": true,
       "inputType": "currency",
       "placeholder": "Enter your monthly salary"
      },
      {
       "type": "Select",
       "id": "employmentStatusSelect",
       "field": "income.employmentStatus",
       "label": "Employment Status",
       "required": true,
       "options": [
        "Full-Time",
        "Part-Time",
        "Self-Employed",
        "Unemployed",
        "Retired"
       ]
      },
      {
       "type": "ActionBar",
       "id": "formActionBar",
       "primary": {
        "label": "Save Changes",
        "actions": [
         {
          "type": "submit",
          "form": "incomeDetailsForm",
          "validate": true
         },
         {
          "type": "navigate",
          "screen": "dashboard",
          "passRecord": false
         }
        ]
       },
       "secondary": {
        "label": "Cancel",
        "actions": [
         {
          "type": "navigate",
          "screen": "dashboard",
          "passRecord": false
         }
        ]
       }
      }
     ]
    }
   ]
  }
 ]
}